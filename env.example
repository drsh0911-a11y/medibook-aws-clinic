# Copy to app/.env and fill in after AWS deployment (us-east-1 only)
FLASK_SECRET_KEY=change-me-to-a-long-random-string

# Leave DB_HOST empty for local demo mode (in-memory, no RDS)
DB_HOST=
DB_USER=admin
DB_PASSWORD=
DB_NAME=clinic_db

AWS_REGION=us-east-1
SNS_TOPIC_ARN=
S3_BUCKET_NAME=
CLOUDFRONT_URL=
